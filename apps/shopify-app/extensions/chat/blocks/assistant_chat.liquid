<div
  data-position="{{ block.settings.position }}"
  data-shopName="{{ shop.permanent_domain }}"
  id="support-ai-chat-place"
  style="
    position: fixed;
    {% if block.settings.position == 'bottom-right' %}
      bottom: 1rem;
      right: 1rem;
    {% elsif block.settings.position == 'bottom-left' %}
      bottom: 1rem;
      left: 1rem;
    {% elsif block.settings.position == 'top-right' %}
      top: 1rem;
      right: 1rem;
    {% elsif block.settings.position == 'top-left' %}
      top: 1rem;
      left: 1rem;
    {% endif %}
    z-index: 10000;
  "
  data-shopId="{{ shop.id }}"
>{{ block.settings.position }}</div>

<link
  rel="stylesheet"
  href="{{ "chat.css" | asset_url }}"
/>

<script
  id="support-ai-chat-id"
  type="module"
  src="{{ "chat.js" | asset_url }}"
  defer
></script>


{% schema %}
{
  "name": "AI Assistant widget",
  "target": "body",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Widget position",
      "options": [
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "top-right", "label": "Top right" },
        { "value": "top-left", "label": "Top left" }
      ],
      "default": "bottom-right"
    }
  ]
}
{% endschema %}